<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TEMPLATE - do not use directly.
  The file that is actually used is generated automatically by
  AUTO_UPDATE_ENABLE.command with the correct path and placed in
  ~/Library/LaunchAgents/. __CHARTHORIZON_DIR__ stands for the folder
  where ChartHorizon lives.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.charthorizon.daily-update</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__CHARTHORIZON_DIR__/AUTO_UPDATE_CHARTHORIZON.command</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__CHARTHORIZON_DIR__</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>23</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>__CHARTHORIZON_DIR__/logs/auto_update.log</string>

  <key>StandardErrorPath</key>
  <string>__CHARTHORIZON_DIR__/logs/auto_update_error.log</string>
</dict>
</plist>
